<parthenon/job>
problem_id = provider_lanes

<parthenon/mesh>
# A hyper-rectangular pool of 8 x 8 blocks; the lanes' connectivity comes from the
# example's neighbor providers, not from the block positions
refinement = none
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
pack_size = 16

<parthenon/meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<provider_lanes>
ncycles = 4
# The groups lane is reshuffled and rebuilt (Mesh::RebuildLane) before this cycle
rebuild_cycle = 2
# Rebuild the whole groups lane (true) or only what changed (false)
full_rebuild = false
