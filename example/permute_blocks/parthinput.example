<parthenon/job>
problem_id = permute_blocks

<parthenon/mesh>
# A hyper-rectangular pool of 8 x 8 blocks whose positions carry no meaning: their
# content is permuted over the gids, and the ring lane connects them by identity
refinement = none
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
pack_size = 16

<parthenon/meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<parthenon/time>
nlim = 10
dt_force = 1.0

<parthenon/loadbalancing>
# Mesh::PermuteBlocks runs the user permutation every permute_interval cycles
permute_interval = 3

<permute_blocks>
# false: the permutation is applied without updating the user's pool (check fails)
update_state = true
